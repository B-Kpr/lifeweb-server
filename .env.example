# Life Web Cloud settings. Copy this file to .env next to compose.yaml and fill it in.
# install.sh makes .env for you with a new access code.

# The owner's access code: long and random (24+ characters). Anyone with it can open every board.
# Make one with:  openssl rand -base64 33
LIFEWEB_TOKEN=

# The owner's name, as it shows in History and Chats
LIFEWEB_ADMIN=Owner

# Optional: the owner's LM Studio, shared with everyone's Assistant through the server.
# Best as its Tailscale address, which never changes, e.g. http://100.x.y.z:1234
LIFEWEB_LMSTUDIO=

# The port the server answers on
PORT=3095

# Optional: the public https address of this server, if you give it one (for example with Tailscale Funnel), so the
# connector link for Claude on the web, Cowork and the phone points there. e.g. https://claudevm.tail1234.ts.net
LIFEWEB_PUBLIC_URL=
